/* ============================================================
                    CSV DOWNLOAD
   ============================================================ */

void handleDownload()
{
  String csv = "";

  csv += "Time(ms),Water Level(%),Distance(cm),Flow Rate(L/min),Rain,Water Flow,Status\n";

  int start;

  if (historyCount < HISTORY_SIZE)
  {
    start = 0;
  }
  else
  {
    start = historyIndex;
  }

  for (int i = 0; i < historyCount; i++)
  {
    int index = (start + i) % HISTORY_SIZE;

    csv += String(history[index].timeStamp);
    csv += ",";

    csv += String(history[index].waterLevel, 1);
    csv += ",";

    csv += String(history[index].distance, 1);
    csv += ",";

    csv += String(history[index].flow, 2);
    csv += ",";

    csv += history[index].rain ? "YES" : "NO";
    csv += ",";

    csv += history[index].waterFlow ? "FLOWING" : "NOT FLOWING";
    csv += ",";

    csv += history[index].status;

    csv += "\n";
  }

  server.sendHeader(
    "Content-Disposition",
    "attachment; filename=sewage_monitoring.csv"
  );

  server.send(200, "text/csv", csv);
}

