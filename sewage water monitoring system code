/*
   ============================================================
       ESP8266 SEWAGE WATER MONITORING SYSTEM
   ============================================================

   Hardware:
   - ESP8266 NodeMCU
   - 16x2 I2C LCD
   - Rain Detector
   - HC-SR04 Ultrasonic Sensor
   - Water Flow Meter
   - Digital Water Flow Detector

   Monitoring:
   - Sewage water level
   - Flow rate
   - Water flow status
   - Rain status
   - Blockage detection
   - Overflow detection
   - LCD display
   - WiFi Web Dashboard
   - Live graph
   - CSV download

   IMPORTANT LOGIC:
   Water Flow Detector:
      LOW  = WATER FLOWING
      HIGH = WATER NOT FLOWING

   Rain Sensor:
      LOW  = RAIN
      HIGH = NO RAIN

   ============================================================
*/

#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <Wire.h>
#include <LCD_I2C.h>

/* ============================================================
                      WIFI SETTINGS
   ============================================================ */

const char* WIFI_SSID = "IOTCLOUD";
const char* WIFI_PASSWORD = "12345678";

/* ============================================================
                      PIN DEFINITIONS
   ============================================================ */

// I2C LCD
#define SDA_PIN D2
#define SCL_PIN D1

// Rain detector
#define RAIN_PIN D0

// Ultrasonic sensor
#define TRIG_PIN D5
#define ECHO_PIN D6

// Digital water flow detector
#define WATER_FLOW_DETECTOR D7

// Flow meter pulse output
#define FLOW_METER_PIN D3

/* ============================================================
                    LCD CONFIGURATION
   ============================================================ */
LCD_I2C lcd(0x27, 16, 2);

/* ============================================================
                    WEB SERVER
   ============================================================ */

ESP8266WebServer server(80);

/* ============================================================
                    FLOW METER
   ============================================================ */

// Change this according to your flow meter.
// Common YF-S201 value is approximately 450 pulses/litre.
volatile unsigned long flowPulseCount = 0;

const float PULSES_PER_LITER = 450.0;

unsigned long previousFlowMillis = 0;

float flowRate = 0.0;
float totalLiters = 0.0;

/* ============================================================
                  ULTRASONIC SETTINGS
   ============================================================ */

// Distance from ultrasonic sensor to empty sewage level.
// Change according to your tank/channel installation.
const float EMPTY_DISTANCE_CM = 17.0;

// Minimum distance = maximum water level.
// Change according to your installation.
const float FULL_DISTANCE_CM = 5.0;

// Overflow level percentage
const float OVERFLOW_LEVEL = 90.0;

// Blockage detection water level
const float BLOCKAGE_LEVEL = 65.0;

/* ============================================================
                    SENSOR VARIABLES
   ============================================================ */

float distanceCM = 0.0;
float waterLevelPercent = 0.0;

bool rainDetected = false;
bool waterFlowing = false;

String systemStatus = "STARTING";
String warningStatus = "NONE";

/* ============================================================
                    LCD TIMER
   ============================================================ */

unsigned long lastLCDUpdate = 0;
int lcdPage = 0;

/* ============================================================
                    DATA LOGGING
   ============================================================ */

struct SensorData
{
  unsigned long timeStamp;
  float waterLevel;
  float distance;
  float flow;
  bool rain;
  bool waterFlow;
  String status;
};

#define HISTORY_SIZE 30

SensorData history[HISTORY_SIZE];

int historyIndex = 0;
int historyCount = 0;

unsigned long lastHistoryUpdate = 0;

/* ============================================================
                     INTERRUPT
   ============================================================ */

ICACHE_RAM_ATTR void flowMeterInterrupt()
{
  flowPulseCount++;
}

/* ============================================================
                     READ ULTRASONIC
   ============================================================ */

float readUltrasonic()
{
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(3);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 30000);

  if (duration == 0)
  {
    return -1;
  }

  float distance = duration * 0.0343 / 2.0;

  return distance;
}

/* ============================================================
                  CALCULATE WATER LEVEL
   ============================================================ */

float calculateWaterLevel(float distance)
{
  if (distance < 0)
  {
    return 0;
  }

  float level;

  level = ((EMPTY_DISTANCE_CM - distance) /
           (EMPTY_DISTANCE_CM - FULL_DISTANCE_CM)) * 100.0;

  if (level < 0)
    level = 0;

  if (level > 100)
    level = 100;

  return level;
}

/* ============================================================
                    READ SENSORS
   ============================================================ */

void readSensors()
{
  /* ---------- RAIN ---------- */

  if (digitalRead(RAIN_PIN) == LOW)
  {
    rainDetected = true;
  }
  else
  {
    rainDetected = false;
  }

  /* ---------- WATER FLOW DETECTOR ---------- */

  // LOW = WATER FLOWING
  // HIGH = WATER NOT FLOWING

  if (digitalRead(WATER_FLOW_DETECTOR) == LOW)
  {
    waterFlowing = true;
  }
  else
  {
    waterFlowing = false;
  }

  /* ---------- ULTRASONIC ---------- */

  distanceCM = readUltrasonic();

  if (distanceCM > 0)
  {
    waterLevelPercent = calculateWaterLevel(distanceCM);
  }

  /* ---------- SYSTEM STATUS ---------- */

  if (waterLevelPercent >= OVERFLOW_LEVEL)
  {
    systemStatus = "OVERFLOW";
    warningStatus = "DANGER";
  }

  else if (rainDetected && waterLevelPercent >= 70)
  {
    systemStatus = "RAIN OVERFLOW";
    warningStatus = "WARNING";
  }

  else if (!waterFlowing && waterLevelPercent >= BLOCKAGE_LEVEL)
  {
    systemStatus = "BLOCKAGE";
    warningStatus = "WARNING";
  }

  else if (!waterFlowing)
  {
    systemStatus = "NO FLOW";
    warningStatus = "WARNING";
  }

  else if (waterFlowing && waterLevelPercent < BLOCKAGE_LEVEL)
  {
    systemStatus = "NORMAL FLOW";
    warningStatus = "NORMAL";
  }

  else
  {
    systemStatus = "MONITORING";
    warningStatus = "NORMAL";
  }
}

/* ============================================================
                  CALCULATE FLOW RATE
   ============================================================ */

void calculateFlowRate()
{
  unsigned long currentMillis = millis();

  if (currentMillis - previousFlowMillis >= 1000)
  {
    noInterrupts();

    unsigned long pulses = flowPulseCount;

    flowPulseCount = 0;

    interrupts();

    float liters = pulses / PULSES_PER_LITER;

    flowRate = liters * 60.0;

    totalLiters += liters;

    previousFlowMillis = currentMillis;
  }
}

/* ============================================================
                    LCD HELPER
   ============================================================ */

void clearLCD()
{
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("                ");
  lcd.setCursor(0, 1);
  lcd.print("                ");
  lcd.clear();
}

/* ============================================================
                    LCD PAGE 1
   ============================================================ */

void displayLCDPage1()
{
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("LEVEL:");

  lcd.print((int)waterLevelPercent);
  lcd.print("%");

  lcd.setCursor(0, 1);

  if (waterFlowing)
  {
    lcd.print("FLOW: YES");
  }
  else
  {
    lcd.print("FLOW: NO");
  }
}

/* ============================================================
                    LCD PAGE 2
   ============================================================ */

void displayLCDPage2()
{
  lcd.clear();

  lcd.setCursor(0, 0);

  lcd.print("FLOW:");
  lcd.print(flowRate, 1);
  lcd.print(" L/m");

  lcd.setCursor(0, 1);

  if (rainDetected)
  {
    lcd.print("RAIN: YES");
  }
  else
  {
    lcd.print("RAIN: NO");
  }
}

/* ============================================================
                    LCD PAGE 3
   ============================================================ */

void displayLCDPage3()
{
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("STATUS:");

  lcd.setCursor(0, 1);

  if (systemStatus == "NORMAL FLOW")
  {
    lcd.print("NORMAL FLOW");
  }

  else if (systemStatus == "NO FLOW")
  {
    lcd.print("NO FLOW");
  }

  else if (systemStatus == "BLOCKAGE")
  {
    lcd.print("BLOCKAGE!");
  }

  else if (systemStatus == "OVERFLOW")
  {
    lcd.print("OVERFLOW!");
  }

  else if (systemStatus == "RAIN OVERFLOW")
  {
    lcd.print("RAIN OVERFLOW");
  }

  else
  {
    lcd.print(systemStatus);
  }
}

/* ============================================================
                    LCD PAGE 4
   ============================================================ */

void displayLCDPage4()
{
  lcd.clear();

  lcd.setCursor(0, 0);

  lcd.print("DIST:");

  if (distanceCM > 0)
  {
    lcd.print(distanceCM, 1);
    lcd.print("cm");
  }
  else
  {
    lcd.print("ERROR");
  }

  lcd.setCursor(0, 1);

  lcd.print("TOTAL:");
  lcd.print(totalLiters, 1);
  lcd.print("L");
}

/* ============================================================
                    UPDATE LCD
   ============================================================ */

void updateLCD()
{
  if (millis() - lastLCDUpdate < 3000)
  {
    return;
  }

  lastLCDUpdate = millis();

  if (lcdPage == 0)
  {
    displayLCDPage1();
  }

  else if (lcdPage == 1)
  {
    displayLCDPage2();
  }

  else if (lcdPage == 2)
  {
    displayLCDPage3();
  }

  else
  {
    displayLCDPage4();
  }

  lcdPage++;

  if (lcdPage > 3)
  {
    lcdPage = 0;
  }
}

/* ============================================================
                  SAVE HISTORY DATA
   ============================================================ */

void saveHistory()
{
  if (millis() - lastHistoryUpdate < 5000)
  {
    return;
  }

  lastHistoryUpdate = millis();

  history[historyIndex].timeStamp = millis();

  history[historyIndex].waterLevel = waterLevelPercent;

  history[historyIndex].distance = distanceCM;

  history[historyIndex].flow = flowRate;

  history[historyIndex].rain = rainDetected;

  history[historyIndex].waterFlow = waterFlowing;

  history[historyIndex].status = systemStatus;

  historyIndex++;

  if (historyIndex >= HISTORY_SIZE)
  {
    historyIndex = 0;
  }

  if (historyCount < HISTORY_SIZE)
  {
    historyCount++;
  }
}

