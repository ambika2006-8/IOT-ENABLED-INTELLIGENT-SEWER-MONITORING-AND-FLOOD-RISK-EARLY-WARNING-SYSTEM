/* ============================================================
                    WIFI CONNECTION
   ============================================================ */

void connectWiFi()
{
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Connecting WiFi");

  lcd.setCursor(0, 1);
  lcd.print(WIFI_SSID);

  WiFi.mode(WIFI_STA);

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );

  int count = 0;

  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);

    lcd.setCursor(15, 0);
    lcd.print(".");

    count++;

    if (count >= 30)
    {
      lcd.clear();

      lcd.setCursor(0, 0);
      lcd.print("WiFi Failed");

      lcd.setCursor(0, 1);
      lcd.print("Restarting...");

      delay(2000);

      ESP.restart();
    }
  }

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("WiFi Connected");

  lcd.setCursor(0, 1);

  lcd.print(WiFi.localIP());

  delay(3000);
}

/* ============================================================
                    SETUP
   ============================================================ */

void setup()
{
  Serial.begin(115200);

  /* ---------- I2C ---------- */

  Wire.begin(
    SDA_PIN,
    SCL_PIN
  );

  /* ---------- LCD ---------- */

  lcd.begin();
  lcd.backlight();

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("SEWAGE WATER");

  lcd.setCursor(0, 1);
  lcd.print("MONITORING");

  delay(2500);

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("ESP8266 SYSTEM");

  lcd.setCursor(0, 1);
  lcd.print("STARTING...");

  delay(1500);

  /* ---------- PIN MODES ---------- */

  pinMode(
    RAIN_PIN,
    INPUT_PULLUP
  );

  pinMode(
    WATER_FLOW_DETECTOR,
    INPUT_PULLUP
  );

  pinMode(
    FLOW_METER_PIN,
    INPUT_PULLUP
  );

  pinMode(
    TRIG_PIN,
    OUTPUT
  );

  pinMode(
    ECHO_PIN,
    INPUT
  );

  digitalWrite(
    TRIG_PIN,
    LOW
  );

  /* ---------- FLOW INTERRUPT ---------- */

  attachInterrupt(
    digitalPinToInterrupt(FLOW_METER_PIN),
    flowMeterInterrupt,
    RISING
  );

  /* ---------- WIFI ---------- */

  connectWiFi();

  /* ---------- WEB SERVER ---------- */

  server.on(
    "/",
    handleRoot
  );

  server.on(
    "/api/data",
    handleAPI
  );

  server.on(
    "/download",
    handleDownload
  );

  server.onNotFound(
    handleNotFound
  );

  server.begin();

  Serial.println();
  Serial.println("==============================");
  Serial.println("SEWAGE MONITORING SYSTEM");
  Serial.println("==============================");

  Serial.print("IP Address: ");
  Serial.println(
    WiFi.localIP()
  );

  Serial.println("Web Server Started");

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("WEB SERVER OK");

  lcd.setCursor(0, 1);
  lcd.print(WiFi.localIP());

  delay(3000);
}

/* ============================================================
                    MAIN LOOP
   ============================================================ */

void loop()
{
  /* ---------- WEB SERVER ---------- */

  server.handleClient();

  /* ---------- SENSOR READING ---------- */

  readSensors();

  /* ---------- FLOW CALCULATION ---------- */

  calculateFlowRate();

  /* ---------- LCD ---------- */

  updateLCD();

  /* ---------- HISTORY ---------- */

  saveHistory();

  /* ---------- SERIAL MONITOR ---------- */

  static unsigned long lastSerial = 0;

  if (millis() - lastSerial >= 3000)
  {
    lastSerial = millis();

    Serial.println();
    Serial.println("------------------------------");

    Serial.print("Water Level : ");
    Serial.print(waterLevelPercent);
    Serial.println(" %");

    Serial.print("Distance    : ");
    Serial.print(distanceCM);
    Serial.println(" cm");

    Serial.print("Flow Rate   : ");
    Serial.print(flowRate);
    Serial.println(" L/min");

    Serial.print("Total Water : ");
    Serial.print(totalLiters);
    Serial.println(" L");

    Serial.print("Rain        : ");

    if (rainDetected)
      Serial.println("YES");
    else
      Serial.println("NO");

    Serial.print("Water Flow  : ");

    if (waterFlowing)
      Serial.println("FLOWING");
    else
      Serial.println("NOT FLOWING");

    Serial.print("STATUS      : ");
    Serial.println(systemStatus);

    Serial.print("WARNING     : ");
    Serial.println(warningStatus);

    Serial.println("------------------------------");
  }

  delay(50);
}